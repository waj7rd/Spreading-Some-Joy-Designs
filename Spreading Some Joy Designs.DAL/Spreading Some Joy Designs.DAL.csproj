<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Spreading Some Joy Designs.Domain\Spreading Some Joy Designs.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core provider for SQL Server. Pinned to 8.0.* so the EF Core major
         version matches the .NET 8 target framework. This one package pulls in
         EF Core itself as a dependency. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.*" />

    <!-- Artwork arrives as bytes from a stranger's URL or upload. This decodes
         it to find out what it actually is, and re-encodes it to strip whatever
         else was riding along in the original container. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="4.0.*" />

    <!-- The image fetcher is an HttpClient consumer; this is what supplies it
         a pooled, correctly-disposed one outside the web project's DI. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SpreadingJoy.DAL</RootNamespace>
  </PropertyGroup>

</Project>
