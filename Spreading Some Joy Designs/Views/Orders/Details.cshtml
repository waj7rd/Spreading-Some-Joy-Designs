@model OrderDetailsViewModel
@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="sj-section-title mb-0">Order #@Model.Id</h1>
    <span class="sj-pill sj-pill-@Model.Status.ToLowerInvariant()">@Model.Status</span>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="table-responsive sj-card p-3">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Design</th>
                        <th>Garment</th>
                        <th>Size</th>
                        <th class="text-end">Qty</th>
                        <th class="text-end">Each</th>
                        <th class="text-end">Line</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>@line.DesignName</td>
                            <td>@line.GarmentName</td>
                            <td>@line.SizeCode</td>
                            <td class="text-end">@line.Quantity</td>
                            <td class="text-end">@line.UnitPrice.ToString("C")</td>
                            <td class="text-end">@line.LineTotal.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    @* Split out only when there's postage to split out. A
                       collection order showing a zero postage line would be
                       noise on every order the studio has ever taken. *@
                    @if (Model.IsShipping)
                    {
                        <tr class="sj-muted">
                            <td colspan="5">Garments</td>
                            <td class="text-end">@Model.Subtotal.ToString("C")</td>
                        </tr>
                        <tr class="sj-muted">
                            <td colspan="5">Postage</td>
                            <td class="text-end">@Model.ShippingFee.ToString("C")</td>
                        </tr>
                    }
                    <tr class="fw-bold">
                        <td colspan="3">Total</td>
                        <td class="text-end">@Model.GarmentCount</td>
                        <td></td>
                        <td class="text-end">@Model.Total.ToString("C")</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="sj-card p-3 mt-3">
                <div class="fw-bold mb-1">Notes</div>
                <div class="sj-muted">@Model.Notes</div>
            </div>
        }

        @if (Model.Status == OrderStatus.Cancelled)
        {
            <div class="alert alert-danger mt-3 mb-0">
                <strong>Cancelled.</strong> @Model.CancellationReason
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="sj-card p-3 mb-3">
            <div class="fw-bold mb-2">Customer</div>
            <div>@Model.CustomerName</div>
            @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone))
            {
                <div class="sj-muted">@Model.CustomerPhone</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
            {
                <div class="sj-muted">@Model.CustomerEmail</div>
            }
        </div>

        <div class="sj-card p-3 mb-3">
            <div class="fw-bold mb-2">@(Model.IsShipping ? "Posting to" : "Collection")</div>
            @if (Model.IsShipping)
            {
                @foreach (var line in Model.ShipToLines)
                {
                    <div>@line</div>
                }

                @* Shouldn't be reachable — an order can't be placed as shipping
                   without one — but a blank card here would read as "no address
                   needed" rather than as something being wrong. *@
                @if (Model.ShipToLines.Count == 0)
                {
                    <div class="text-danger">No address on this order — don't post it.</div>
                }

                <div class="sj-muted mt-2">Postage charged: @Model.ShippingFee.ToString("C")</div>

                @if (Model.HasBeenDispatched)
                {
                    <div class="mt-3 pt-3 border-top">
                        <div class="fw-semibold">
                            Posted @Model.DispatchedAt!.Value.ToLocalTime().ToString("d MMM yyyy, HH:mm")
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Carrier))
                        {
                            <div class="sj-muted">via @Model.Carrier</div>
                        }
                        @if (!string.IsNullOrEmpty(Model.TrackingNumber))
                        {
                            @* Shown as text, not a link. Which carrier's tracking site
                               a reference belongs to is a guess, and a guess that sends
                               a customer to the wrong one is worse than a number they
                               can paste in themselves. *@
                            <div>Tracking: <code>@Model.TrackingNumber</code></div>
                        }
                    </div>
                }
                else if (Model.AwaitingDispatch)
                {
                    <form asp-action="MarkShipped" method="post" class="mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="returnTo" value="details" />

                        <div class="fw-semibold mb-2">Post it</div>

                        <div class="row g-2">
                            <div class="col-sm-5">
                                <label for="carrier" class="form-label small mb-1">Carrier</label>
                                <input type="text" class="form-control form-control-sm" id="carrier"
                                       name="carrier" maxlength="50" placeholder="USPS" />
                            </div>
                            <div class="col-sm-7">
                                <label for="trackingNumber" class="form-label small mb-1">Tracking number</label>
                                <input type="text" class="form-control form-control-sm" id="trackingNumber"
                                       name="trackingNumber" maxlength="100" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-sm btn-primary mt-2">Mark shipped</button>

                        @* Both blank is a perfectly good dispatch. Refusing to record
                           one for want of a reference number would mean the studio
                           stops recording them at all. *@
                        <div class="sj-muted small mt-2">
                            Both optional — leave them blank if there's no reference.
                        </div>
                    </form>
                }
            }
            else
            {
                <div class="sj-muted">Being collected from the studio.</div>
            }
        </div>

        <div class="sj-card p-3 mb-3">
            <div class="fw-bold mb-2">Dates</div>
            <div class="sj-muted">Placed @Model.CreatedAt.ToString("d MMM yyyy")</div>
            <div>Due <strong>@Model.DueOn.ToString("dddd d MMMM")</strong></div>
        </div>

        <div class="sj-card p-3 mb-3">
            <div class="fw-bold mb-2">Artwork rights</div>
            @if (Model.RightsAttested)
            {
                <div class="text-success">
                    Confirmed by the customer
                    @if (Model.RightsAttestedAt.HasValue)
                    {
                        <span class="sj-muted d-block">
                            @Model.RightsAttestedAt.Value.ToString("d MMM yyyy HH:mm") UTC
                        </span>
                    }
                </div>
            }
            else
            {
                <div class="text-danger">Not confirmed — do not print.</div>
            }
        </div>

        @if (Model.Status != OrderStatus.Completed && Model.Status != OrderStatus.Cancelled)
        {
            <div class="sj-card p-3">
                <div class="fw-bold mb-2">Cancel this order</div>
                <form asp-action="Cancel" method="post"
                      data-confirm="Cancel this order? The customer should be told why.">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-2">
                        <label class="form-label small" for="cancel-reason">Reason</label>
                        <textarea id="cancel-reason" name="reason" class="form-control form-control-sm"
                                  rows="2" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">Cancel order</button>
                </form>
            </div>
        }
    </div>
</div>

<div class="mt-4">
    <a class="btn btn-outline-joy" asp-action="Board">Back to production</a>
</div>
