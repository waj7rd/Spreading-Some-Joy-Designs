@{
    ViewData["Title"] = "Order sent";
}

<div class="row justify-content-center">
    <div class="col-lg-7 text-center py-5">
        <h1 class="sj-section-title mb-3">Thanks — we've got it.</h1>
        <p class="lead">
            Your order is with us. We'll check the artwork, confirm the date we can have it
            ready, and get in touch on the number you left.
        </p>
        <p class="sj-muted mb-4">
            Nothing goes to the press until a person here has looked at the image, so if
            there's any problem with it you'll hear from us first.
        </p>
        <a class="btn btn-joy" asp-controller="Designer" asp-action="Index">Design another</a>
        <a class="btn btn-outline-joy ms-2" asp-controller="Home" asp-action="Index">Back to the start</a>
    </div>
</div>
