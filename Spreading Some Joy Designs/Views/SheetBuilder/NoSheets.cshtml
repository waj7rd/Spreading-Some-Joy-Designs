@{
    ViewData["Title"] = "Gang sheets";
}

<div class="sj-card p-4 p-md-5 text-center mx-auto" style="max-width:40rem;">
    <h1 class="sj-section-title mb-3">Gang sheets aren't on sale yet</h1>

    <p class="sj-muted mb-4">
        We're not offering sheets at the moment. Give us a ring if you need one —
        we may be able to sort something out.
