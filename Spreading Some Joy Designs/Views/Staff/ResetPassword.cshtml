@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="row">
    <div class="col-lg-6">
        <h1 class="sj-section-title mb-1">Reset password</h1>
        <p class="sj-muted mb-4">for @Model.FullName</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form asp-action="ResetPassword" method="post">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="FullName" />

            <div class="mb-4">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <div class="form-text">
                    This also clears any lockout. Tell them the new password in person, not by email.
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-joy">Reset password</button>
            <a class="btn btn-link" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
