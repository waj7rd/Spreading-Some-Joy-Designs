{
  // Local development only. Windows auth against a local SQL Server, so there is
  // no password here to leak — which is exactly why this one can be committed
  // and the production string cannot.
  "ConnectionStrings": {
    "SpreadingJoyContext": "Server=(localdb)\\MSSQLLocalDB;Database=SpreadingJoy;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
