{
  "ConnectionStrings": {
    "SpreadingJoyContext": "Server=.;Database=SpreadingJoy;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Artwork": {
    // Relative to the content root. Deliberately not under wwwroot: static
    // files there are served with no code in the way, which would make every
    // stored image publicly readable by anyone who guessed a URL — including
    // the ones a moderator rejected.
    "StoragePath": "App_Data/artwork"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",

      // EF logs every query at Information, which drowns everything else.
      "Microsoft.EntityFrameworkCore": "Warning",

      // The application's own logging, kept above the framework noise. Auth
      // failures and refused artwork fetches come through here.
      "SpreadingJoy": "Information"
    }
  },
  "AllowedHosts": "*"
}
