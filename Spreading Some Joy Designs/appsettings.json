{
  // Empty on purpose — this file is in source control, and the hosted database
  // is reached with a SQL username and password. Local development picks the
  // string up from appsettings.Development.json; the deployed site sets the
  // environment variable ConnectionStrings__SpreadingJoyContext (two
  // underscores). Program.cs refuses to start if neither is present.
  "ConnectionStrings": {
    "SpreadingJoyContext": ""
  },

  // Where the data protection keyring lives. These keys encrypt the auth
  // cookie, the session cookie, and antiforgery tokens; losing them on every
  // app pool recycle signs all staff out and breaks every form. Relative to the
  // content root, and under App_Data because that is not served — anyone who
  // can read this folder can forge a staff login.
  "DataProtection": {
    "KeyPath": "App_Data/keys"
  },
  // Off unless the app sits behind a reverse proxy. See the note in Program.cs:
  // trusting X-Forwarded-For when the app is directly reachable lets anyone
  // forge their own IP and walk past the rate limits. When you do turn it on,
  // list the proxy addresses — ASP.NET ignores the header otherwise.
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "ForwardLimit": 1
  },
  "Artwork": {
    // Relative to the content root. Deliberately not under wwwroot: static
    // files there are served with no code in the way, which would make every
    // stored image publicly readable by anyone who guessed a URL — including
    // the ones a moderator rejected.
    "StoragePath": "App_Data/artwork"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",

      // EF logs every query at Information, which drowns everything else.
      "Microsoft.EntityFrameworkCore": "Warning",

      // The application's own logging, kept above the framework noise. Auth
      // failures and refused artwork fetches come through here.
      "SpreadingJoy": "Information"
    }
  },
  "AllowedHosts": "*"
}
